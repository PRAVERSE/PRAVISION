# ==============================================================================
# PRAVISION - Production Environment Configuration Template
# COPY this file to .env on your secure deployment host.
# NEVER commit real credentials to version control.
# ==============================================================================

# --- Database: Neon Lakebase PostgreSQL ---
# Production pooled connection string (recommended):
DATABASE_URL=postgresql+asyncpg://<username>:<password>@ep-plain-tree-a1b2c3d4-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
NEON_API_KEY=

# --- Object Storage: Neon S3-Compatible Storage ---
AWS_ACCESS_KEY_ID=<your-neon-s3-access-key-id>
AWS_SECRET_ACCESS_KEY=<your-neon-s3-secret-access-key>
S3_ENDPOINT_URL=https://s3.ap-southeast-1.amazonaws.com
S3_BUCKET_NAME=pravision-evidence
S3_REGION=ap-southeast-1

# --- Security: JWT Authentication & Initial RBAC ---
# Generate a strong 64-character secret using: openssl rand -hex 32
JWT_SECRET=<generate_with_openssl_rand_hex_32>

# Initial bootstrap credentials for pre-configured roles
ADMIN_INITIAL_PASSWORD=ChangeThisAdminPassword2026!
OFFICER_INITIAL_PASSWORD=ChangeThisOfficerPassword2026!
ANALYST_INITIAL_PASSWORD=ChangeThisAnalystPassword2026!

# --- Cloudflare Tunnel ---
# Obtained from Cloudflare Zero Trust Dashboard -> Networks -> Tunnels
CLOUDFLARE_TUNNEL_TOKEN=

# --- Frontend Build Variables (Used during Cloudflare Pages Build) ---
# Set these in Cloudflare Pages dashboard -> Settings -> Environment Variables
# VITE_API_BASE_URL=https://api.pravision.yourdomain.com/api
# VITE_WS_URL=wss://api.pravision.yourdomain.com
